# PROBE P3 / P4 (Dev-board measurement), built from this one file:
#   P3 = P2 (static binary + relocated self-contained Python fallback under /opt/pyfb) + image ENV
#        NVIDIA_DRIVER_CAPABILITIES=utility: if the runtime's GPU request leaves the capability set to
#        the image, the NVIDIA hook injects only the utility libraries (nvidia-smi / NVML) instead of
#        the default compute+utility set (libcuda, PTX JIT, ...). NVIDIA_VISIBLE_DEVICES is NOT set:
#        the GPU request stays exactly what the platform asks for, and the container cannot fail
#        because of it. No NVIDIA_REQUIRE_* is set (no CUDA requirement check).
#   P4 = P3 with /opt/pyfb trimmed to what the Python engine loads (probe/trim_pyfb.py: unused
#        numpy/scipy/pyarrow sub-packages, extension modules and bundled libraries, tests, headers,
#        non -O byte-code, unused stdlib, stripped .so), checked byte-identical before/after on every
#        synthetic scenario the Python engine runs.
#   docker buildx build --platform linux/amd64 --build-arg TRIM=0 -t jpsim:p3 -f t3-work/Dockerfile.probe-p34 t3-work
#   P5 = P4 + packed: stdlib in one python311.zip (sourceless -O byte-code), site-packages and
#        /opt/jpsim as sourceless legacy .pyc (one file per module), checked byte-identical again.
#   docker buildx build --platform linux/amd64 --build-arg TRIM=2 -t jpsim:p5 -f t3-work/Dockerfile.probe-p34 t3-work
#   docker buildx build --platform linux/amd64 --build-arg TRIM=1 -t jpsim:p4 -f t3-work/Dockerfile.probe-p34 t3-work
#
# --- P2 description (unchanged below) ---
# PROBE P2 (Dev-board measurement): the static binary on the hot path + a SELF-CONTAINED Python
# fallback under /opt/pyfb that nothing else in the image (and no linker cache) knows about.
#   * no /lib, /usr/lib, /lib64, no /etc/ld.so.conf.d, empty /etc/ld.so.conf, no /etc/ld.so.cache:
#     an ldconfig run against this rootfs (e.g. the NVIDIA hook's) finds no library directory of ours;
#   * /opt/pyfb/bin/python3.11 is patched to use /opt/pyfb/lib/ld-linux-x86-64.so.2 as its ELF
#     interpreter; every shared library it or numpy/pyarrow/scipy need (glibc, libstdc++, libpython,
#     libffi, ...) is copied into /opt/pyfb/lib and found through LD_LIBRARY_PATH, which only the
#     fallback launcher (/usr/local/bin/simulate-py, a static busybox sh script) sets;
#   * /etc holds only passwd/group (+ the empty ld.so.conf).
# The hot path (simulate / simulate-batch = one static binary) touches nothing under /opt.
#   docker buildx build --platform linux/amd64 -t jpsim:p2 -f t3-work/Dockerfile.probe-p2 t3-work
FROM --platform=linux/amd64 python:3.11-slim-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends g++ patchelf busybox-static strace \
 && rm -rf /var/lib/apt/lists/*
COPY engine/jpkernel /src/jpkernel
RUN g++ -O2 -std=c++17 -fno-fast-math -ffp-contract=off -DJPK_NO_EXPORTS \
        -static -pthread -Wl,--gc-sections -ffunction-sections -fdata-sections -s \
        -o /src/jpsim-native /src/jpkernel/jpsim_native.cpp \
 && (ldd /src/jpsim-native 2>&1 | grep -q "not a dynamic executable")
RUN pip install --no-cache-dir "numpy==1.26.4" "pyarrow==15.0.2" "scipy==1.17.1"
COPY engine /stage/opt/jpsim
COPY probe/simulate-py probe/simulate-batch-py /stage/usr/local/bin/
RUN set -eu; S=/stage; P=$S/opt/pyfb; mkdir -p $P/bin $P/lib $S/usr/local/bin $S/etc $S/tmp; \
    find $S/opt/jpsim -type d -exec chmod 0755 {} +; find $S/opt/jpsim -type f -exec chmod 0644 {} +; \
    PYTHONPATH=$S/opt/jpsim python -m compileall -q -j 0 -o 0 -o 1 $S/opt/jpsim \
        /usr/local/lib/python3.11/site-packages/numpy /usr/local/lib/python3.11/site-packages/pyarrow; \
    rm -rf /usr/local/lib/python3.11/site-packages/pip* /usr/local/lib/python3.11/site-packages/setuptools* \
           /usr/local/lib/python3.11/site-packages/wheel* /usr/local/lib/python3.11/ensurepip \
           /usr/local/lib/python3.11/idlelib /usr/local/lib/python3.11/tkinter /usr/local/lib/python3.11/turtledemo; \
    cp -a /usr/local/lib/python3.11 $P/lib/; \
    cp -L /usr/local/lib/libpython3.11.so.1.0 $P/lib/; \
    cp /usr/local/bin/python3.11 $P/bin/python3.11; \
    cp /bin/busybox $P/bin/sh; \
    for i in 1 2; do \
      find $P -type f \( -name '*.so' -o -name '*.so.*' -o -path "$P/bin/python3.11" \) -print0 \
        | xargs -0 -n 50 ldd 2>/dev/null | awk '$2 == "=>" && $3 ~ /^\// {print $3}' \
        | grep -v "^$P/" | sort -u | while read -r l; do cp -Ln "$l" $P/lib/; done; \
    done; \
    cp -L /lib64/ld-linux-x86-64.so.2 $P/lib/ld-linux-x86-64.so.2; \
    patchelf --set-interpreter /opt/pyfb/lib/ld-linux-x86-64.so.2 --set-rpath /opt/pyfb/lib $P/bin/python3.11; \
    cp /src/jpsim-native $S/usr/local/bin/simulate; \
    ln $S/usr/local/bin/simulate $S/usr/local/bin/simulate-batch; \
    ln $S/usr/local/bin/simulate $S/usr/local/bin/jpsim-native; \
    chmod 0755 $S/usr/local/bin/*; chmod 1777 $S/tmp; \
    printf 'root:x:0:0:root:/root:/sbin/nologin\nnobody:x:65534:65534:nobody:/nonexistent:/sbin/nologin\n' > $S/etc/passwd; \
    printf 'root:x:0:\nnogroup:x:65534:\n' > $S/etc/group; : > $S/etc/ld.so.conf; \
    ls $P/lib | grep -v '^python3.11$' | tr '\n' ' '; echo; \
    find $S -type f | wc -l
# P4 only: trim the fallback to what the Python engine loads, checked byte-identical before/after.
ARG TRIM=0
COPY probe/trim_pyfb.py tools/synthetic_check.py /src/trim/
RUN if [ "$TRIM" != "0" ]; then       ln -s /stage/opt/pyfb /opt/pyfb && ln -s /stage/opt/jpsim /opt/jpsim       && python /src/trim/trim_pyfb.py /stage /src/trim/synthetic_check.py $([ "$TRIM" = "2" ] && echo --pack)       && rm /opt/pyfb /opt/jpsim && du -sh /stage /stage/opt/pyfb && find /stage -type f | wc -l;     fi
# In-build self-test, isolated from the build stage's system libraries: chroot-free check through
# the relocated loader with an empty system search path (no /etc/ld.so.cache is consulted for
# libraries found via LD_LIBRARY_PATH; anything missing from /opt/pyfb/lib would fail in the final
# image, which CI also tests directly).
RUN env -i LD_LIBRARY_PATH=/stage/opt/pyfb/lib PYTHONHOME=/stage/opt/pyfb PYTHONPATH=/stage/opt/jpsim \
      /stage/opt/pyfb/lib/ld-linux-x86-64.so.2 --library-path /stage/opt/pyfb/lib --inhibit-cache \
      /stage/opt/pyfb/bin/python3.11 -c "import jpsim.cli, abides_core.abides, jpsim.config, jpsim.trace_fast, scipy.spatial.distance, pyarrow.parquet; print('fallback import ok')"

FROM scratch
COPY --from=build /stage /
LABEL qfbench2.interface_version="2.0"
LABEL qfbench2.track="simulation"
LABEL org.opencontainers.image.source="https://github.com/dapeipeipeipei/agenthon"
LABEL org.opencontainers.image.description="Agenthon 2026 Track 3 simulator (jpsim): static C++ kernel binary + relocated self-contained Python ABIDES fallback (probe P3/P4)"
ENV PATH=/usr/local/bin HOME=/tmp NVIDIA_DRIVER_CAPABILITIES=utility
WORKDIR /tmp
USER 65534:65534
CMD ["simulate", "--help"]
