#!/usr/local/bin/python3 -OS
# Track 3 submission verb: simulate --config /input/scenario.json --out /output/trace.parquet
# Started directly by the kernel's shebang (no /bin/sh in between): -O because assert statements
# are not part of the simulation semantics, -S because site.py / .pth processing is pure start-up
# cost (PYTHONPATH in the image carries /opt/jpsim and site-packages).
import sys

sys.argv.insert(1, "simulate")
from jpsim.cli import run  # noqa: E402

run()
